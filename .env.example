# ── Ollama ────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── ChromaDB ──────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=neuron_docs

# ── Whisper ───────────────────────────────────────────────
# Options: tiny | base | small | medium | large
# "base" is the recommended default — fast and accurate enough
WHISPER_MODEL_SIZE=base

# ── FastAPI ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info        # debug | info | warning | error

# ── Environment ───────────────────────────────────────────
# Set to "test" in CI — disables real Ollama/Whisper calls
ENV=development
